{
  "name": "m4tr1x",
  "version": "2.0.0",
  "description": "M4TR1X — The Unfiltered Eye. Decentralized social network for authentic video documentation.",
  "author": "H8dboy",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "server": "node server/index.js"
  },
  "build": {
    "appId": "com.h8dboy.m4tr1x",
    "productName": "M4TR1X",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*",
      "server/**/*",
      "assets/**/*",
      "models/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{exe,bat,cmd}",
      "!**/node_modules/ffmpeg-static/ffmpeg.exe",
      "!**/node_modules/ffprobe-static/bin/win32/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "monero-javascript": "^0.8.4",
    "multer": "^1.4.5-lts.1",
    "nostr-tools": "^2.3.1",
    "onnxruntime-node": "^1.17.3",
    "sharp": "^0.33.2",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  }
}
